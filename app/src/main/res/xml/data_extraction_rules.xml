<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: explicit exclusions also protect device transfer on OEM implementations. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="apa_api_credentials.xml" />
        <exclude domain="device_sharedpref" path="apa_api_credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="apa_api_credentials.xml" />
        <exclude domain="device_sharedpref" path="apa_api_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
